.DS_Store
.vscode/
.ruff_cache/

# Swift / SwiftPM (app/)
.build/
.swiftpm/
DerivedData/
xcuserdata/

# XcodeGen output -- app/ios/project.yml is the source of truth; all of
# these are regenerated by `xcodegen generate` and must not be hand-edited.
app/ios/KnowledgePress.xcodeproj/
app/ios/Info.plist
app/ios/KnowledgePress.entitlements
app/ios/build/
# The staged corpus (make ios-stage-corpus); only the placeholder is tracked.
app/ios/Corpus/*
!app/ios/Corpus/.gitkeep
app/macos/KnowledgePress.xcodeproj/
app/macos/Info.plist
app/macos/KnowledgePress.entitlements
app/macos/build/
# The staged corpus (make mac-stage-corpus); only the placeholder is tracked.
app/macos/Corpus/*
!app/macos/Corpus/.gitkeep
app/fm-repro/FMRepro.xcodeproj/
app/fm-repro/Info.plist
app/fm-repro/build/

# Screenshots and test renders from checking the forest by hand.
renders/tests/

# Icon concept sketches; the chosen artwork lives in app/icon/.
renders/icon-concepts/

# KG artefacts. The snapshot manifests under .tscodekg/snapshots/ are the
# tracked history; the graph and vector databases are rebuilt locally.
.tscodekg/*
!.tscodekg/snapshots/
.kgcache/

# Simulator screenshots (make ios-sim-screenshot)
screenshots/

# Book text for the forest reader (make web-books); published as a release asset.
web/public/books/
